{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:intruoyi:approval-content:edhr-release:contract-design:1",
  "title": "EDHR_RELEASE canonical business content — task design, not deployed validator",
  "description": "Every property is mandatory; nullable source snapshots retain explicit null. Cross-field identity, max Long, reference uniqueness, ordering, raw snapshot shape, count formulas and writer locking require the semantic contract.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contentPolicyVersion",
    "scopeCode",
    "identity",
    "workTask",
    "release",
    "finalization"
  ],
  "properties": {
    "contentPolicyVersion": {
      "const": "approval-content-v1"
    },
    "scopeCode": {
      "const": "EDHR_RELEASE"
    },
    "identity": {
      "$ref": "#/$defs/identity"
    },
    "workTask": {
      "allOf": [
        {
          "if": {
            "properties": {
              "assignmentBranch": {
                "const": "MANAGED"
              }
            }
          },
          "then": {
            "properties": {
              "assigneeUserId": {
                "$ref": "#/$defs/id"
              },
              "candidate": {
                "properties": {
                  "sourceType": {
                    "const": "ROLE_GROUP"
                  }
                }
              },
              "responsibility": {
                "properties": {
                  "sourceType": {
                    "const": "ROLE"
                  },
                  "sourceKey": {
                    "const": "MES_MANAGEMENT_REPRESENTATIVE"
                  },
                  "sourceVersion": {
                    "$ref": "#/$defs/sha256"
                  },
                  "sourceDigest": {
                    "$ref": "#/$defs/sha256"
                  }
                }
              }
            }
          }
        }
      ],
      "$ref": "#/$defs/workTask"
    },
    "release": {
      "$ref": "#/$defs/release"
    },
    "finalization": {
      "$ref": "#/$defs/finalization"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$",
      "maxLength": 19,
      "description": "ASCII positive Java Long; semantic validator also enforces <=9223372036854775807."
    },
    "version": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$",
      "maxLength": 19,
      "description": "Exact positive integral source version encoded as decimal; semantic Long/Integer source-range check."
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\+08:00$",
      "description": "Persisted business LocalDateTime interpreted in explicit Asia/Shanghai, seconds and +08:00; no client-zone or current-clock fill."
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenantId",
        "ownerCode",
        "sourceTaskType",
        "sourceTaskId",
        "processInstanceId",
        "domainSubjectType",
        "domainSubjectId"
      ],
      "properties": {
        "tenantId": {
          "$ref": "#/$defs/id"
        },
        "ownerCode": {
          "const": "EDHR"
        },
        "sourceTaskType": {
          "const": "EDHR_WORK_TASK"
        },
        "sourceTaskId": {
          "$ref": "#/$defs/id"
        },
        "processInstanceId": {
          "type": "null"
        },
        "domainSubjectType": {
          "const": "EDHR_RELEASE"
        },
        "domainSubjectId": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceType",
        "sourceId",
        "userSnapshot",
        "userIds"
      ],
      "properties": {
        "sourceType": {
          "enum": [
            "USER",
            "ROLE_GROUP",
            "DEPT_GROUP"
          ]
        },
        "sourceId": {
          "$ref": "#/$defs/id"
        },
        "userSnapshot": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(,[1-9][0-9]*)*$"
        },
        "userIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "responsibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceType",
        "sourceKey",
        "sourceVersion",
        "sourceDigest",
        "scopeJsonRaw"
      ],
      "properties": {
        "sourceType": {
          "type": "string",
          "minLength": 1
        },
        "sourceKey": {
          "type": "string",
          "minLength": 1
        },
        "sourceVersion": {
          "type": "string",
          "minLength": 1
        },
        "sourceDigest": {
          "type": "string",
          "minLength": 1
        },
        "scopeJsonRaw": {
          "type": "null"
        }
      }
    },
    "workTask": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "businessScopeType",
        "businessScopeId",
        "batchExecutionId",
        "workOrderId",
        "status",
        "assignmentBranch",
        "assigneeUserId",
        "candidate",
        "responsibility"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "const": "RELEASE_APPROVE"
        },
        "businessScopeType": {
          "const": "RELEASE_TRANSACTION"
        },
        "businessScopeId": {
          "$ref": "#/$defs/id"
        },
        "batchExecutionId": {
          "$ref": "#/$defs/id"
        },
        "workOrderId": {
          "$ref": "#/$defs/id"
        },
        "status": {
          "enum": [
            "TODO",
            "OVERDUE"
          ]
        },
        "assignmentBranch": {
          "enum": [
            "GENERAL",
            "MANAGED"
          ]
        },
        "assigneeUserId": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "candidate": {
          "$ref": "#/$defs/candidate"
        },
        "responsibility": {
          "$ref": "#/$defs/responsibility"
        }
      }
    },
    "batchIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "batchExecutionCode",
        "batchCode",
        "workOrderId",
        "workOrderCode"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "batchExecutionCode": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "batchCode": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "workOrderId": {
          "$ref": "#/$defs/id"
        },
        "workOrderCode": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "code",
        "name"
      ],
      "properties": {
        "id": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "code",
        "name",
        "versionId",
        "versionNo"
      ],
      "properties": {
        "id": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "versionId": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "versionNo": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "checkCount": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "failed",
        "blocking"
      ],
      "properties": {
        "required": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "blocking": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "checkEvidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checkItemId",
        "releaseTransactionId",
        "sourceObjectType",
        "sourceObjectId",
        "evidenceHash"
      ],
      "properties": {
        "checkItemId": {
          "$ref": "#/$defs/id"
        },
        "releaseTransactionId": {
          "$ref": "#/$defs/id"
        },
        "sourceObjectType": {
          "type": "string",
          "minLength": 1
        },
        "sourceObjectId": {
          "type": "string",
          "minLength": 1
        },
        "evidenceHash": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "checkItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "result",
        "evidenceRefs"
      ],
      "properties": {
        "code": {
          "enum": [
            "DHR_COMPLETENESS",
            "DOSSIER_INCOMING_INSPECTION_REPORT",
            "DOSSIER_STERILIZATION_REPORT",
            "DOSSIER_FINISHED_PRODUCT_INSPECTION_REPORT",
            "DOSSIER_FINISHED_PRODUCT_INSPECTION_RECORD",
            "INSPECTION_RESULT",
            "DEVIATION_CLOSED",
            "REWORK_CLOSED",
            "SCRAP_RECORDED",
            "INVENTORY_CONSISTENCY"
          ]
        },
        "result": {
          "enum": [
            "PASS",
            "FAIL",
            "BLOCKER",
            "NOT_APPLICABLE"
          ]
        },
        "evidenceRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/checkEvidenceRef"
          },
          "minItems": 1,
          "uniqueItems": true,
          "maxItems": 1
        }
      }
    },
    "precheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items"
      ],
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/checkItem"
          },
          "minItems": 10,
          "uniqueItems": true,
          "maxItems": 10
        }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "releaseCode",
        "batch",
        "product",
        "route",
        "dhrStatus",
        "inspectionStatus",
        "deviationStatus",
        "reworkStatus",
        "scrapStatus",
        "inventoryStatus",
        "releaseStatus",
        "checkCount",
        "precheckSnapshot"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "version": {
          "$ref": "#/$defs/version"
        },
        "releaseCode": {
          "type": "string",
          "minLength": 1
        },
        "batch": {
          "$ref": "#/$defs/batchIdentity"
        },
        "product": {
          "$ref": "#/$defs/product"
        },
        "route": {
          "$ref": "#/$defs/route"
        },
        "dhrStatus": {
          "type": "string",
          "minLength": 1
        },
        "inspectionStatus": {
          "type": "string",
          "minLength": 1
        },
        "deviationStatus": {
          "type": "string",
          "minLength": 1
        },
        "reworkStatus": {
          "type": "string",
          "minLength": 1
        },
        "scrapStatus": {
          "type": "string",
          "minLength": 1
        },
        "inventoryStatus": {
          "type": "string",
          "minLength": 1
        },
        "releaseStatus": {
          "const": "PENDING_APPROVAL"
        },
        "checkCount": {
          "$ref": "#/$defs/checkCount"
        },
        "precheckSnapshot": {
          "$ref": "#/$defs/precheck"
        }
      }
    },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "tenantId",
        "batchExecutionId",
        "entryType",
        "originKey",
        "activeOrderId",
        "workOrderId",
        "completionTransactionId",
        "completionVersion",
        "completionBackfillReceiptId",
        "completionBackfillReceiptHash",
        "pickListBindingId",
        "pickListId",
        "pickListBindingVersion",
        "hasActualLoss",
        "sourceSnapshotHash",
        "batchProvisionReceiptId",
        "batchProvisionStatus",
        "sourceCredentialId",
        "sourceCredentialHash",
        "sourceBundleHash",
        "idempotencyKey",
        "relationStatus"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "tenantId": {
          "$ref": "#/$defs/id"
        },
        "batchExecutionId": {
          "$ref": "#/$defs/id"
        },
        "entryType": {
          "enum": [
            "ACTIVE_ORDER_COMPLETION",
            "MANUAL",
            "SCHEDULED",
            "PQC_INDEPENDENT"
          ]
        },
        "originKey": {
          "type": "string",
          "minLength": 1
        },
        "activeOrderId": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "workOrderId": {
          "$ref": "#/$defs/id"
        },
        "completionTransactionId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "completionVersion": {
          "anyOf": [
            {
              "$ref": "#/$defs/version"
            },
            {
              "type": "null"
            }
          ]
        },
        "completionBackfillReceiptId": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "completionBackfillReceiptHash": {
          "anyOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "pickListBindingId": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "pickListId": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "pickListBindingVersion": {
          "anyOf": [
            {
              "$ref": "#/$defs/version"
            },
            {
              "type": "null"
            }
          ]
        },
        "hasActualLoss": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "sourceSnapshotHash": {
          "$ref": "#/$defs/sha256"
        },
        "batchProvisionReceiptId": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "batchProvisionStatus": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "sourceCredentialId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "sourceCredentialHash": {
          "anyOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "sourceBundleHash": {
          "anyOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "idempotencyKey": {
          "type": "string",
          "minLength": 1
        },
        "relationStatus": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "trace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "originLinkId",
        "traceLinkHash",
        "sourceSnapshotHash",
        "relationStatus"
      ],
      "properties": {
        "originLinkId": {
          "$ref": "#/$defs/id"
        },
        "traceLinkHash": {
          "$ref": "#/$defs/sha256"
        },
        "sourceSnapshotHash": {
          "$ref": "#/$defs/sha256"
        },
        "relationStatus": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "pickListSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pickListBindingId",
        "pickListId",
        "bindingVersion",
        "sourceSnapshotHash"
      ],
      "properties": {
        "pickListBindingId": {
          "$ref": "#/$defs/id"
        },
        "pickListId": {
          "$ref": "#/$defs/id"
        },
        "bindingVersion": {
          "$ref": "#/$defs/version"
        },
        "sourceSnapshotHash": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "sourceEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceType",
        "sourceId",
        "sourceVersion",
        "sourceSnapshotHash",
        "payloadHash",
        "signature"
      ],
      "properties": {
        "sourceType": {
          "type": "string",
          "minLength": 1
        },
        "sourceId": {
          "type": "string",
          "minLength": 1
        },
        "sourceVersion": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "sourceSnapshotHash": {
          "anyOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "payloadHash": {
          "anyOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "signature": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "$comment": "Exact existing independent canonical payload six fields. Issuer attests inputs, not independent source-owner verification. Sort and reject duplicate (sourceType,sourceId). Independent branch requires all six nonempty; completion null remains current reader absence."
    },
    "completionReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receiptId",
        "tenantId",
        "activeOrderId",
        "workOrderId",
        "workOrderCode",
        "batchCode",
        "routeId",
        "routeVersionId",
        "requestIdempotencyKey",
        "createdAt",
        "sourceSnapshotHash",
        "formalSourceSnapshotJsonRaw",
        "signatureSnapshotJsonRaw",
        "completionVersion",
        "expectedActiveOrderVersion",
        "completionTransactionId",
        "completionEventId",
        "sourceVersion",
        "sourceBundleHash",
        "receiptVersion",
        "payloadHash",
        "auditEventId",
        "receiptHash",
        "status",
        "batchRecordStatus",
        "processInspectionStatus",
        "batchRecordId",
        "processInspectionId",
        "batchRecordSourceIds",
        "processInspectionSourceIds",
        "hasActualLoss",
        "lossConditionFactsJsonRaw",
        "lossQuantity",
        "lossReportStatus",
        "lossRecordId",
        "zeroLossConfirmationSnapshotRaw",
        "pickListSources",
        "sourceEvidence"
      ],
      "properties": {
        "receiptId": {
          "$ref": "#/$defs/id"
        },
        "tenantId": {
          "$ref": "#/$defs/id"
        },
        "activeOrderId": {
          "$ref": "#/$defs/id"
        },
        "workOrderId": {
          "$ref": "#/$defs/id"
        },
        "workOrderCode": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "batchCode": {
          "type": "string",
          "minLength": 1
        },
        "routeId": {
          "$ref": "#/$defs/id"
        },
        "routeVersionId": {
          "$ref": "#/$defs/id"
        },
        "requestIdempotencyKey": {
          "type": "string",
          "minLength": 1
        },
        "createdAt": {
          "$ref": "#/$defs/timestamp"
        },
        "sourceSnapshotHash": {
          "$ref": "#/$defs/sha256"
        },
        "formalSourceSnapshotJsonRaw": {
          "type": "string",
          "minLength": 1,
          "description": "Opaque formal owner raw; exact string preserved under FLOW4_COMPLETION_RECEIPT_CURRENT_LITERAL. Syntax/duplicate/number guard, exact verified reader, original owner hashes and creation P1 required; no nested semantic qualification; null rules in policy."
        },
        "signatureSnapshotJsonRaw": {
          "type": "string",
          "minLength": 1,
          "description": "Opaque formal owner raw; exact string preserved under FLOW4_COMPLETION_RECEIPT_CURRENT_LITERAL. Syntax/duplicate/number guard, exact verified reader, original owner hashes and creation P1 required; no nested semantic qualification; null rules in policy."
        },
        "completionVersion": {
          "$ref": "#/$defs/version"
        },
        "expectedActiveOrderVersion": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$",
              "maxLength": 10
            },
            {
              "type": "null"
            }
          ]
        },
        "completionTransactionId": {
          "type": "string",
          "minLength": 1
        },
        "completionEventId": {
          "type": "string",
          "minLength": 1
        },
        "sourceVersion": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "sourceBundleHash": {
          "anyOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "receiptVersion": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
