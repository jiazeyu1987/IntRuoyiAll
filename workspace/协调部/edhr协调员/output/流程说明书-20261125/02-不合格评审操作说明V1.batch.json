  {
    "command": "add",
    "type": "paragraph",
    "props": {
      "lineSpacing": "1.25x",
      "text": "步骤 1｜检验复核阶段：PQC组长进入“PQC管理”，找到本轮待复核记录，使用该条的“不合格审查／不合格评审”操作。需要从这里发起时，不要先普通审核通过，把入口办没了。",
      "spaceAfter": "6pt",
      "size": "11pt",
      "font": "微软雅黑",
      "keepLines": "true",
      "color": "#222222"
    },
    "parent": "/body"
  },
