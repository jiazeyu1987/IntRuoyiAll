{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "checkpointResults": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "checkpointSort": {
            "type": "integer",
            "minimum": 1
          },
          "status": {
            "type": "string",
            "enum": ["PASS", "FAIL", "BLOCKED"]
          },
          "actualText": {
            "type": "string",
            "minLength": 1
          },
          "mismatchDescription": {
            "type": ["string", "null"]
          }
        },
        "required": ["checkpointSort", "status", "actualText", "mismatchDescription"]
      }
    },
    "summary": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": ["checkpointResults", "summary"]
}
